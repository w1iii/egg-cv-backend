ENVIRONMENT=production
DEBUG=false
DATABASE_URL=postgresql://user:password@host:5432/database
CORS_ORIGINS=https://your-frontend.vercel.app
UPLOAD_DIR=/var/data/uploads

# The API has no authentication: anyone who can reach it can upload, read and
# delete inspections. Production refuses to start until you acknowledge this
# explicitly. Prefer a private network / VPN; set true only if you accept it.
ACCEPT_UNAUTHENTICATED_ACCESS=false

# Schema is managed by Alembic (`alembic upgrade head`). Only for a throwaway
# local database may this be true; it is rejected in production.
AUTO_CREATE_SCHEMA=false

# Release gates. Leave false until the evidence in docs/ exists and is signed off.
CLEANLINESS_RELEASE_APPROVED=false
ARUCO_GRADES_APPROVED=false
